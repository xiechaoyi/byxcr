<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>byxcr</AssemblyName>
    <RootNamespace>Byxcr</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Version>1.0.0</Version>
    <Product>byxcr</Product>
    <Description>兼容 NativeAOT 的容器镜像下载与同步工具</Description>

    <!-- 全局无区域化，减小体积并避免 AOT 下的 ICU 依赖 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 但时区必须真实可用：否则 TimeZoneInfo.Local 恒为 UTC，list/records 会显示 UTC 时间 -->
    <InvariantTimezone>false</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite 自带 SQLitePCLRaw.bundle_e_sqlite3，可配合 NativeAOT 使用 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
